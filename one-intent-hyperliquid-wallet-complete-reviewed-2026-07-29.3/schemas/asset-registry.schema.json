{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/asset-registry.schema.json",
  "title": "Signed Asset Registry Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "registryId",
    "environment",
    "generatedAt",
    "validUntil",
    "signatureState",
    "signerKeyId",
    "signature",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "registryId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{8,120}$" },
    "environment": { "enum": ["SIMULATION", "STAGING", "PRODUCTION"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "signatureState": { "enum": ["UNSIGNED_SIMULATION", "SIGNED"] },
    "signerKeyId": { "type": ["string", "null"], "maxLength": 160 },
    "signature": { "type": ["string", "null"], "maxLength": 512 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "retrievedAt", "contentSha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "url": { "type": "string", "format": "uri", "maxLength": 600 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "contentSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "decimals"],
      "properties": {
        "symbol": { "type": "string", "pattern": "^[A-Z0-9._-]{1,20}$" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 36 }
      }
    },
    "jpyc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "contract", "decimals", "verificationStatus", "codeHash"],
      "properties": {
        "symbol": { "const": "JPYC" },
        "contract": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{40}$" },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 36 },
        "verificationStatus": { "enum": ["SIMULATION_ONLY", "VERIFIED_CURRENT", "EXPIRED", "CONFLICT"] },
        "codeHash": { "type": ["string", "null"], "pattern": "^0x[0-9a-fA-F]{64}$" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkId",
        "displayNameJa",
        "chainId",
        "nativeFeeAsset",
        "jpyc",
        "sources",
        "productionEligible"
      ],
      "properties": {
        "networkId": { "type": "string", "pattern": "^[a-z0-9]+:[A-Za-z0-9._-]+$" },
        "displayNameJa": { "type": "string", "minLength": 1, "maxLength": 80 },
        "chainId": { "type": "integer", "minimum": 1 },
        "nativeFeeAsset": { "$ref": "#/$defs/asset" },
        "jpyc": { "$ref": "#/$defs/jpyc" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/source" }
        },
        "productionEligible": { "type": "boolean" }
      }
    }
  }
}
