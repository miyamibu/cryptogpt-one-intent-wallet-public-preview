{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/atomic-signer-request-v2.schema.json",
  "title": "AtomicSignerRequestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalProfile",
    "issuer",
    "subject",
    "audience",
    "environment",
    "deployment",
    "requestId",
    "operationSpec",
    "operationSpecDigest",
    "reviewReceipt",
    "reviewReceiptDigest",
    "runtimeDecision",
    "runtimeDecisionDigest",
    "authorizationId",
    "nonce",
    "requestedAt",
    "notBefore",
    "expiresAt",
    "canonicalDigest",
    "signatureAlgorithm",
    "keyId",
    "signature",
    "revocationEpoch"
  ],
  "properties": {
    "schemaVersion": {"const": "2.1"},
    "canonicalProfile": {"const": "CGPT-C14N-1"},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
    "subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "audience": {"type": "string", "minLength": 1, "maxLength": 256},
    "environment": {"enum": ["STAGING", "TESTNET", "PRODUCTION"]},
    "deployment": {"type": "string", "minLength": 1, "maxLength": 256},
    "requestId": {"type": "string", "minLength": 1, "maxLength": 128},
    "operationSpec": {"$ref": "operation-spec-v2.schema.json"},
    "operationSpecDigest": {"$ref": "#/$defs/digest"},
    "reviewReceipt": {"$ref": "user-review-receipt-v2.schema.json"},
    "reviewReceiptDigest": {"$ref": "#/$defs/digest"},
    "runtimeDecision": {"$ref": "runtime-decision-envelope-v2.schema.json"},
    "runtimeDecisionDigest": {"$ref": "#/$defs/digest"},
    "authorizationId": {"type": "string", "minLength": 1, "maxLength": 128},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 256},
    "requestedAt": {"type": "integer", "minimum": 0},
    "notBefore": {"type": "integer", "minimum": 0},
    "expiresAt": {"type": "integer", "minimum": 0},
    "canonicalDigest": {"$ref": "#/$defs/digest"},
    "signatureAlgorithm": {"const": "Ed25519"},
    "keyId": {"type": "string", "minLength": 1, "maxLength": 256},
    "signature": {"type": "string", "minLength": 1, "maxLength": 4096},
    "revocationEpoch": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
