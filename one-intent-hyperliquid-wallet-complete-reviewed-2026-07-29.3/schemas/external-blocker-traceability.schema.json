{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/external-blocker-traceability.schema.json",
  "title": "ExternalBlockerTraceability",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "status", "blockers", "coverage"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "release": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "status": { "const": "CANONICAL_TRACEABILITY" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageVersion", "walletDependencyVersion", "personalWalletRequired", "gateCount", "claimCount", "gates", "claims"],
      "properties": {
        "coverageVersion": { "const": "1.0" },
        "walletDependencyVersion": { "const": "1.0" },
        "personalWalletRequired": { "const": false },
        "gateCount": { "type": "integer", "minimum": 1 },
        "claimCount": { "type": "integer", "minimum": 1 },
        "gates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["gateId", "claimIds", "blockerIds", "classification", "walletDependency", "personalWalletRequired"],
            "properties": {
              "gateId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
              "claimIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" }
              },
              "blockerIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^EXT-[0-9]{3}$" }
              },
              "classification": {
                "enum": ["EXTERNAL_BLOCKER", "MIXED", "INTERNAL_IMPLEMENTATION"]
              },
              "walletDependency": {
                "enum": ["NONE", "CONTROLLED_TESTNET_OR_PROVIDER_IDENTITY", "PRODUCTION_SIGNER_MAINNET_OR_PROTECTED_RUNTIME"]
              },
              "personalWalletRequired": { "const": false }
            }
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claimId", "gateId", "blockerIds", "classification", "walletDependency", "personalWalletRequired"],
            "properties": {
              "claimId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" },
              "gateId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
              "blockerIds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^EXT-[0-9]{3}$" }
              },
              "classification": {
                "enum": ["EXTERNAL_BLOCKER", "INTERNAL_IMPLEMENTATION"]
              },
              "walletDependency": {
                "enum": ["NONE", "CONTROLLED_TESTNET_OR_PROVIDER_IDENTITY", "PRODUCTION_SIGNER_MAINNET_OR_PROTECTED_RUNTIME"]
              },
              "personalWalletRequired": { "const": false }
            }
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "legacyAliases",
          "directGateIds",
          "dependentGateIds",
          "claimIds",
          "ownerRole",
          "reviewerRole",
          "portal",
          "evidencePath",
          "verificationCommand",
          "successCriteria",
          "requiredMaterials",
          "secretsPolicy",
          "featureFlags",
          "revalidateBy",
          "escalationContact",
          "status"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^EXT-[0-9]{3}$" },
          "legacyAliases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "directGateIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
          },
          "dependentGateIds": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
          },
          "claimIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" }
          },
          "ownerRole": { "type": "string", "minLength": 1, "maxLength": 128 },
          "reviewerRole": { "type": "string", "minLength": 1, "maxLength": 128 },
          "portal": { "type": "string", "minLength": 1, "maxLength": 256 },
          "evidencePath": { "type": "string", "minLength": 1, "maxLength": 512 },
          "verificationCommand": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "successCriteria": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "requiredMaterials": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          },
          "secretsPolicy": { "type": "string", "minLength": 1, "maxLength": 512 },
          "featureFlags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 128 }
          },
          "revalidateBy": {
            "enum": ["REVALIDATE_ON_EVERY_RELEASE", "REVALIDATE_ON_EVERY_EXTERNAL_CHANGE"]
          },
          "escalationContact": { "type": "string", "minLength": 1, "maxLength": 256 },
          "status": { "const": "BLOCKED_EXTERNAL" }
        }
      }
    }
  }
}
