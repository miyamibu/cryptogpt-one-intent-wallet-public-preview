{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/fee-route-capability.schema.json",
  "title": "Fee Route Capability Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capabilityId",
    "environment",
    "provider",
    "networkId",
    "accountExecutionModel",
    "supportsZeroNativeBalance",
    "bootstrapMethod",
    "prerequisites",
    "supportedAssets",
    "quoteBinding",
    "chargeOnRevert",
    "evidence",
    "productionEligible"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "capabilityId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{8,120}$" },
    "environment": { "enum": ["SIMULATION", "STAGING", "PRODUCTION"] },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "legalName", "supportUrl", "termsUrl", "jurisdiction"],
      "properties": {
        "providerId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{3,120}$" },
        "legalName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "supportUrl": { "type": "string", "format": "uri" },
        "termsUrl": { "type": "string", "format": "uri" },
        "jurisdiction": { "type": "string", "minLength": 2, "maxLength": 80 }
      }
    },
    "networkId": { "type": "string", "pattern": "^[a-z0-9]+:[A-Za-z0-9._-]+$" },
    "accountExecutionModel": { "enum": ["EOA", "SMART_ACCOUNT_ERC4337", "PROTOCOL_NATIVE", "RELAYER"] },
    "supportsZeroNativeBalance": { "type": "boolean" },
    "bootstrapMethod": { "enum": ["NONE", "PAYMASTER", "RELAYER", "PROTOCOL_NATIVE_SPONSOR", "EXTERNAL_TOPUP"] },
    "prerequisites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingNativeBalanceRequired", "allowanceRequired", "permitStandard", "entryPoint", "accountFactory"],
      "properties": {
        "existingNativeBalanceRequired": { "type": "boolean" },
        "allowanceRequired": { "type": "boolean" },
        "permitStandard": { "enum": ["NONE", "EIP2612", "PERMIT2", "CUSTOM"] },
        "entryPoint": { "type": ["string", "null"], "maxLength": 120 },
        "accountFactory": { "type": ["string", "null"], "maxLength": 120 }
      }
    },
    "supportedAssets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetRegistryId", "networkId", "symbol", "contract"],
        "properties": {
          "assetRegistryId": { "type": "string", "minLength": 8, "maxLength": 120 },
          "networkId": { "type": "string", "pattern": "^[a-z0-9]+:[A-Za-z0-9._-]+$" },
          "symbol": { "type": "string", "pattern": "^[A-Z0-9._-]{1,20}$" },
          "contract": { "type": "string", "pattern": "^0x[0-9A-Fa-f]{40}$" }
        }
      }
    },
    "quoteBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredFields", "signatureAlgorithm", "replayProtection"],
      "properties": {
        "requiredFields": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "account",
              "networkId",
              "asset",
              "operation",
              "amount",
              "nonce",
              "expiresAt",
              "maxJpycCost",
              "feeAssetCost",
              "providerSettlementTarget"
            ]
          }
        },
        "signatureAlgorithm": { "type": "string", "minLength": 1, "maxLength": 80 },
        "replayProtection": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "chargeOnRevert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "capJpyc"],
      "properties": {
        "mode": { "enum": ["NEVER", "ACTUAL_COST_UP_TO_CAP", "FIXED_DISCLOSED"] },
        "capJpyc": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "retrievedAt", "expiresAt", "independentAuditReportId", "contentSha256"],
      "properties": {
        "status": { "enum": ["SIMULATION_ONLY", "VERIFIED", "EXPIRED", "REVOKED"] },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "independentAuditReportId": { "type": ["string", "null"], "maxLength": 160 },
        "contentSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "productionEligible": { "type": "boolean" }
  }
}
