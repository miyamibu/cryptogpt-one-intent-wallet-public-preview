{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/gate-decisions.schema.json",
  "title": "DesignGateDecisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "release", "status", "decisions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "release": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}\\.\\d+$" },
    "status": { "const": "DESIGN_ONLY_NO_GO" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gateId", "decision", "claimIds", "reason"],
        "properties": {
          "gateId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "decision": { "const": "NO_GO" },
          "claimIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,95}$" }
          },
          "reason": { "type": "string", "minLength": 20 }
        }
      }
    }
  }
}
