{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/operation-spec-v2.schema.json",
  "title": "OperationSpecV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalProfile",
    "operationId",
    "operationType",
    "account",
    "network",
    "assetId",
    "orderedActions",
    "registryDigest",
    "quoteDigest",
    "sourceStateDigest",
    "payloadCommitment",
    "displayManifestDigest",
    "operationDetails",
    "expiresAt"
  ],
  "properties": {
    "schemaVersion": {"const": "2.1"},
    "canonicalProfile": {"const": "CGPT-C14N-1"},
    "operationId": {"type": "string", "minLength": 1, "maxLength": 128},
    "operationType": {
      "enum": [
        "TRANSFER",
        "SWAP",
        "PERP_OPEN",
        "PERP_CLOSE",
        "VAULT_DEPOSIT",
        "VAULT_WITHDRAW",
        "CANCEL",
        "REVOKE_AUTHORIZATION"
      ]
    },
    "account": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
    "network": {
      "enum": [
        "eip155:137",
        "eip155:42161",
        "eip155:421614",
        "hyperliquid:mainnet",
        "hyperliquid:testnet"
      ]
    },
    "assetId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,255}$"},
    "orderedActions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "TRANSFER",
          "SWAP",
          "PERP_OPEN",
          "PERP_CLOSE",
          "VAULT_DEPOSIT",
          "VAULT_WITHDRAW",
          "CANCEL",
          "REVOKE_AUTHORIZATION"
        ]
      }
    },
    "registryDigest": {"$ref": "#/$defs/digest"},
    "quoteDigest": {"$ref": "#/$defs/digest"},
    "sourceStateDigest": {"$ref": "#/$defs/digest"},
    "payloadCommitment": {"$ref": "#/$defs/digest"},
    "displayManifestDigest": {"$ref": "#/$defs/digest"},
    "operationDetails": {"type": "object"},
    "expiresAt": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"operationType": {"const": "TRANSFER"}}},
      "then": {
        "properties": {
          "orderedActions": {"const": ["TRANSFER"]},
          "operationDetails": {"$ref": "#/$defs/transfer"}
        }
      }
    },
    {
      "if": {"properties": {"operationType": {"const": "SWAP"}}},
      "then": {
        "properties": {
          "orderedActions": {"const": ["SWAP"]},
          "operationDetails": {"$ref": "#/$defs/swap"}
        }
      }
    },
    {
      "if": {"properties": {"operationType": {"const": "PERP_OPEN"}}},
      "then": {
        "properties": {
          "orderedActions": {"const": ["PERP_OPEN"]},
          "operationDetails": {"$ref": "#/$defs/perpOpen"}
        }
      }
    },
    {
      "if": {"properties": {"operationType": {"const": "PERP_CLOSE"}}},
      "then": {
        "properties": {
          "orderedActions": {"const": ["PERP_CLOSE"]},
          "operationDetails": {"$ref": "#/$defs/perpClose"}
        }
      }
    },
    {
      "if": {"properties": {"operationType": {"const": "VAULT_DEPOSIT"}}},
      "then": {
        "properties": {
          "orderedActions": {"const": ["VAULT_DEPOSIT"]},
          "operationDetails": {"$ref": "#/$defs/vaultDeposit"}
        }
      }
    },
    {
      "if": {"properties": {"operationType": {"const": "VAULT_WITHDRAW"}}},
      "then": {
        "properties": {
          "orderedActions": {"const": ["VAULT_WITHDRAW"]},
          "operationDetails": {"$ref": "#/$defs/vaultWithdraw"}
        }
      }
    },
    {
      "if": {"properties": {"operationType": {"const": "CANCEL"}}},
      "then": {
        "properties": {
          "orderedActions": {"const": ["CANCEL"]},
          "operationDetails": {"$ref": "#/$defs/cancel"}
        }
      }
    },
    {
      "if": {"properties": {"operationType": {"const": "REVOKE_AUTHORIZATION"}}},
      "then": {
        "properties": {
          "orderedActions": {"const": ["REVOKE_AUTHORIZATION"]},
          "operationDetails": {"$ref": "#/$defs/revoke"}
        }
      }
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$", "maxLength": 128},
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "recipient", "tokenContract", "fee", "feeRecipient"],
      "properties": {
        "amount": {"$ref": "#/$defs/decimal"},
        "recipient": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
        "tokenContract": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
        "fee": {"$ref": "#/$defs/decimal"},
        "feeRecipient": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"}
      }
    },
    "swap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "outputAssetId", "minimumOutput", "maximumSlippageBps", "fee", "feeRecipient"],
      "properties": {
        "amount": {"$ref": "#/$defs/decimal"},
        "outputAssetId": {"type": "string", "minLength": 1, "maxLength": 256},
        "minimumOutput": {"$ref": "#/$defs/decimal"},
        "maximumSlippageBps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "fee": {"$ref": "#/$defs/decimal"},
        "feeRecipient": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"}
      }
    },
    "perpOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "side", "leverage", "marginMode", "maximumSlippageBps", "reduceOnly"],
      "properties": {
        "amount": {"$ref": "#/$defs/decimal"},
        "side": {"enum": ["LONG", "SHORT"]},
        "leverage": {"type": "integer", "minimum": 1, "maximum": 100},
        "marginMode": {"enum": ["CROSS", "ISOLATED"]},
        "maximumSlippageBps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "reduceOnly": {"const": false}
      }
    },
    "perpClose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "side", "positionId", "maximumSlippageBps", "reduceOnly"],
      "properties": {
        "amount": {"$ref": "#/$defs/decimal"},
        "side": {"enum": ["LONG", "SHORT"]},
        "positionId": {"type": "string", "minLength": 1, "maxLength": 256},
        "maximumSlippageBps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "reduceOnly": {"const": true}
      }
    },
    "vaultDeposit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "vaultId"],
      "properties": {
        "amount": {"$ref": "#/$defs/decimal"},
        "vaultId": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "vaultWithdraw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "vaultId", "recipient"],
      "properties": {
        "amount": {"$ref": "#/$defs/decimal"},
        "vaultId": {"type": "string", "minLength": 1, "maxLength": 256},
        "recipient": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"}
      }
    },
    "cancel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetOperationId", "marketId"],
      "properties": {
        "targetOperationId": {"type": "string", "minLength": 1, "maxLength": 128},
        "marketId": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "revoke": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizationId", "authorizationKeyId"],
      "properties": {
        "authorizationId": {"type": "string", "minLength": 1, "maxLength": 128},
        "authorizationKeyId": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
