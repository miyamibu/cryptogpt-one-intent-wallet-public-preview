{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/operational-evidence-statement.schema.json",
  "title": "OperationalEvidenceStatement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "statementId",
    "profileId",
    "gateId",
    "claimId",
    "subject",
    "environment",
    "outcome",
    "issuedAt",
    "expiresAt",
    "issuer",
    "evidence",
    "limitations",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "statementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{8,96}$"
    },
    "gateId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "environment",
        "sourceCommit",
        "sourceTreeSha256",
        "androidArtifactSha256",
        "iosArtifactSha256",
        "backendImageDigest",
        "signerImageDigest",
        "configurationBundleSha256",
        "policyBundleSha256",
        "assetRegistrySha256",
        "sbomSha256"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "environment": {
          "enum": [
            "DESIGN_ONLY",
            "STAGING",
            "TESTNET",
            "PRODUCTION"
          ]
        },
        "sourceCommit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "sourceTreeSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "androidArtifactSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "iosArtifactSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "backendImageDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signerImageDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "configurationBundleSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "policyBundleSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "assetRegistrySha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "sbomSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "environment": {
      "enum": [
        "DESIGN_ONLY",
        "STAGING",
        "TESTNET",
        "PRODUCTION"
      ]
    },
    "outcome": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "role",
        "principalId",
        "organization"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "path",
          "sha256",
          "sizeBytes",
          "mediaType",
          "collectedAt",
          "description"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
          },
          "path": {
            "type": "string",
            "pattern": "^delivery/evidence/(?:artifacts/[A-Za-z0-9._/-]+|README\\.md)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 3,
            "maxLength": 100,
            "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$"
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 268435456
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "keyId",
        "signatureBase64"
      ],
      "properties": {
        "profile": {
          "const": "ONE_INTENT_ED25519_CANONICAL_JSON_V2"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "signatureBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256
        }
      }
    }
  }
}
