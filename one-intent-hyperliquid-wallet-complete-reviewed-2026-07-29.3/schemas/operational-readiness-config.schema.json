{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/operational-readiness-config.schema.json",
  "title": "OperationalReadinessConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "target",
    "releaseSubjectRequiredFields",
    "globalRules",
    "gates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{8,96}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "distribution",
        "clientPlatforms",
        "executionSurface",
        "capabilities",
        "chatgptBoundary"
      ],
      "properties": {
        "jurisdiction": {
          "const": "JP"
        },
        "distribution": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "APPLE_APP_STORE",
              "GOOGLE_PLAY",
              "ENTERPRISE_INTERNAL"
            ]
          }
        },
        "clientPlatforms": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "IOS",
              "ANDROID"
            ]
          }
        },
        "executionSurface": {
          "const": "STANDALONE_WALLET_ONLY"
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          }
        },
        "chatgptBoundary": {
          "const": "READ_ONLY_STATUS_GLOSSARY_GENERIC_SAFETY_AND_NEUTRAL_HANDOFF"
        }
      }
    },
    "releaseSubjectRequiredFields": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9]+$"
      }
    },
    "globalRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentPackageExpectedStatus",
        "productionGoStatus",
        "requireOutOfBandTrustPolicyHash",
        "requireOutOfBandCheckerHash",
        "requireOutOfBandReleaseSubjectHash",
        "requireTrustedTimeAttestation",
        "requireExactReleaseSubjectBinding",
        "requireIssuerReviewerSeparation",
        "requireEvidenceIndexSignature",
        "maxRuntimeLeaseSeconds",
        "maxOperationAuthorizationSeconds",
        "unknownOrConflictingEvidence",
        "runtimeLeaseNeverAuthorizesTransaction",
        "maxTrustedTimeAttestationSeconds",
        "maxEvidenceIndexAgeSeconds"
      ],
      "properties": {
        "currentPackageExpectedStatus": {
          "const": "BLOCKED_NOT_OPERATIONAL"
        },
        "productionGoStatus": {
          "const": "PRODUCTION_OPERATIONAL_GO"
        },
        "requireOutOfBandTrustPolicyHash": {
          "const": true
        },
        "requireOutOfBandCheckerHash": {
          "const": true
        },
        "requireOutOfBandReleaseSubjectHash": {
          "const": true
        },
        "requireTrustedTimeAttestation": {
          "const": true
        },
        "requireExactReleaseSubjectBinding": {
          "const": true
        },
        "requireIssuerReviewerSeparation": {
          "const": true
        },
        "requireEvidenceIndexSignature": {
          "const": true
        },
        "maxRuntimeLeaseSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "maxOperationAuthorizationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "unknownOrConflictingEvidence": {
          "const": "BLOCK"
        },
        "runtimeLeaseNeverAuthorizesTransaction": {
          "const": true
        },
        "maxTrustedTimeAttestationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "maxEvidenceIndexAgeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gateId",
          "category",
          "titleJa",
          "mandatory",
          "claims"
        ],
        "properties": {
          "gateId": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "category": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,31}$"
          },
          "titleJa": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "mandatory": {
            "const": true
          },
          "claims": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claimId",
                "titleJa",
                "issuerRoles",
                "reviewerRoles",
                "approvalThreshold",
                "maxAgeDays",
                "evidenceTypes",
                "environments"
              ],
              "properties": {
                "claimId": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
                },
                "titleJa": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 180
                },
                "issuerRoles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
                  }
                },
                "reviewerRoles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
                  }
                },
                "approvalThreshold": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                "maxAgeDays": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                },
                "evidenceTypes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
                  }
                },
                "environments": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "const": "PRODUCTION"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
