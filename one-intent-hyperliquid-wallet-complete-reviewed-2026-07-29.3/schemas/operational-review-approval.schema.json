{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/operational-review-approval.schema.json",
  "title": "OperationalReviewApproval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "profileId",
    "statementId",
    "statementSha256",
    "subject",
    "decision",
    "reviewer",
    "reviewedAt",
    "comments",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "approvalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{8,96}$"
    },
    "statementId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseId",
        "environment",
        "sourceCommit",
        "sourceTreeSha256",
        "androidArtifactSha256",
        "iosArtifactSha256",
        "backendImageDigest",
        "signerImageDigest",
        "configurationBundleSha256",
        "policyBundleSha256",
        "assetRegistrySha256",
        "sbomSha256"
      ],
      "properties": {
        "releaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "environment": {
          "enum": [
            "DESIGN_ONLY",
            "STAGING",
            "TESTNET",
            "PRODUCTION"
          ]
        },
        "sourceCommit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "sourceTreeSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "androidArtifactSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "iosArtifactSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "backendImageDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "signerImageDigest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "configurationBundleSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "policyBundleSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "assetRegistrySha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "sbomSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REJECT"
      ]
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyId",
        "role",
        "principalId",
        "organization"
      ],
      "properties": {
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "organization": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "principalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "comments": {
      "type": "string",
      "maxLength": 2000
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "keyId",
        "signatureBase64"
      ],
      "properties": {
        "profile": {
          "const": "ONE_INTENT_ED25519_CANONICAL_JSON_V2"
        },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "signatureBase64": {
          "type": "string",
          "minLength": 4,
          "maxLength": 256
        }
      }
    },
    "statementSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
