{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/production-policy-pointer.schema.json",
  "title": "LegacyProductionPolicyPointer",
  "description": "Migration-only schema retained for historical documents. Active production-named files use the canonical operational-trust-policy and runtime-authorization-policy schemas instead.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "profileId",
    "status",
    "active",
    "canonicalPolicyPath",
    "evaluator",
    "outOfBandAnchorsRequired",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "PRODUCTION_POLICY_POINTER" },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{8,96}$"
    },
    "status": { "const": "NOT_PROVISIONED" },
    "active": { "const": false },
    "canonicalPolicyPath": {
      "type": "string",
      "pattern": "^config/[A-Za-z0-9._/-]+\\.json$"
    },
    "evaluator": {
      "type": "string",
      "pattern": "^tools/[A-Za-z0-9._/-]+\\.py$"
    },
    "outOfBandAnchorsRequired": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^ONE_INTENT_[A-Z0-9_]+$"
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
