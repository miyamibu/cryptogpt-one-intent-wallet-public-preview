{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/resolved-intent-v2.schema.json",
  "title": "ResolvedIntentV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "intentId", "sourceCommitment", "locale", "operationType", "materialChoices", "ambiguityResolutionComplete", "resolvedAt"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "intentId": {"type": "string", "minLength": 1, "maxLength": 128},
    "sourceCommitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "locale": {"enum": ["ja-JP", "en-US", "ko-KR", "zh-Hant"]},
    "operationType": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
    "materialChoices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["choiceId", "selectedOptionId", "optionsCommitment"],
        "properties": {
          "choiceId": {"type": "string", "minLength": 1, "maxLength": 96},
          "selectedOptionId": {"type": "string", "minLength": 1, "maxLength": 96},
          "optionsCommitment": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "ambiguityResolutionComplete": {"const": true},
    "resolvedAt": {"type": "string", "format": "date-time"}
  }
}
