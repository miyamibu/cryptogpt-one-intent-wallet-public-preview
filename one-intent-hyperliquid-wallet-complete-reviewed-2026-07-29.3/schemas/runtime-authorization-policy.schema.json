{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/runtime-authorization-policy.schema.json",
  "title": "RuntimeAuthorizationPolicy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "policyVersion",
    "enabled",
    "signatureProfile",
    "canonicalization",
    "requiredOutOfBandEnvironment",
    "network",
    "accountBinding",
    "runtimeState",
    "lease",
    "operation",
    "notes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Z0-9_]{8,96}$"
    },
    "policyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    },
    "enabled": {
      "type": "boolean"
    },
    "signatureProfile": {
      "const": "ONE_INTENT_ED25519_CANONICAL_JSON_V2"
    },
    "canonicalization": {
      "const": "ONE_INTENT_CANONICAL_JSON_SUBSET_V1"
    },
    "requiredOutOfBandEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ONE_INTENT_TRUST_POLICY_SHA256",
        "ONE_INTENT_RUNTIME_AUTHORIZATION_POLICY_SHA256",
        "ONE_INTENT_RUNTIME_AUTHORIZER_SHA256",
        "ONE_INTENT_RELEASE_READINESS_REPORT_SHA256",
        "ONE_INTENT_RELEASE_SUBJECT_SHA256",
        "ONE_INTENT_TRUSTED_TIME_ATTESTATION_SHA256"
      ],
      "properties": {
        "ONE_INTENT_TRUST_POLICY_SHA256": {
          "type": "string",
          "minLength": 16
        },
        "ONE_INTENT_RUNTIME_AUTHORIZATION_POLICY_SHA256": {
          "type": "string",
          "minLength": 16
        },
        "ONE_INTENT_RUNTIME_AUTHORIZER_SHA256": {
          "type": "string",
          "minLength": 16
        },
        "ONE_INTENT_RELEASE_READINESS_REPORT_SHA256": {
          "type": "string",
          "minLength": 16
        },
        "ONE_INTENT_RELEASE_SUBJECT_SHA256": {
          "type": "string",
          "minLength": 16
        },
        "ONE_INTENT_TRUSTED_TIME_ATTESTATION_SHA256": {
          "type": "string",
          "minLength": 16
        }
      }
    },
    "runtimeState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxLifetimeSeconds",
        "signatureThreshold",
        "requiredRoles",
        "minimumDistinctOrganizations"
      ],
      "properties": {
        "maxLifetimeSeconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 300
        },
        "signatureThreshold": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "requiredRoles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "minimumDistinctOrganizations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxLifetimeSeconds",
        "signatureThreshold",
        "requiredRoles",
        "minimumDistinctOrganizations",
        "allowedCapabilities"
      ],
      "properties": {
        "maxLifetimeSeconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 300
        },
        "signatureThreshold": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "requiredRoles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "minimumDistinctOrganizations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "allowedCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "AGENT_ADMIN",
              "ASSET_SEND",
              "BRIDGE_DEPOSIT",
              "BUILDER_FEE_ADMIN",
              "CANCEL_ORDERS",
              "EMERGENCY_CLOSE",
              "INTERNAL_TRANSFER",
              "PERP_TRADE",
              "SPOT_TRADE",
              "VAULT_MANAGE",
              "WITHDRAWAL"
            ]
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxLifetimeSeconds",
        "userRole",
        "deviceRole",
        "policyEngineRole",
        "requireQuoteHash",
        "requireQuoteValidUntil",
        "allowedCapabilities",
        "stepTypeCapabilityMap"
      ],
      "properties": {
        "maxLifetimeSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "userRole": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "deviceRole": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "policyEngineRole": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "requireQuoteHash": {
          "const": true
        },
        "allowedCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "AGENT_ADMIN",
              "ASSET_SEND",
              "BRIDGE_DEPOSIT",
              "BUILDER_FEE_ADMIN",
              "CANCEL_ORDERS",
              "EMERGENCY_CLOSE",
              "INTERNAL_TRANSFER",
              "PERP_TRADE",
              "SPOT_TRADE",
              "VAULT_MANAGE",
              "WITHDRAWAL"
            ]
          }
        },
        "stepTypeCapabilityMap": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "APPROVE_AGENT",
            "APPROVE_BUILDER_FEE",
            "ARBITRUM_BRIDGE_DEPOSIT",
            "ARBITRUM_WITHDRAW",
            "CANCEL_ALL_ORDERS",
            "EMERGENCY_CLOSE",
            "HLP_DEPOSIT",
            "HLP_WITHDRAW",
            "HYPEREVM_VAULT_DEPOSIT",
            "HYPEREVM_VAULT_WITHDRAW",
            "INTERNAL_SPOT_SEND",
            "INTERNAL_USD_SEND",
            "PERP_CANCEL",
            "PERP_CLOSE",
            "PERP_MODIFY",
            "PERP_ORDER",
            "REVOKE_AGENT",
            "SEND_ASSET",
            "SPOT_ORDER",
            "USD_CLASS_TRANSFER",
            "USER_VAULT_DEPOSIT",
            "USER_VAULT_WITHDRAW"
          ],
          "properties": {
            "PERP_ORDER": {
              "const": "PERP_TRADE"
            },
            "PERP_CANCEL": {
              "const": "PERP_TRADE"
            },
            "PERP_MODIFY": {
              "const": "PERP_TRADE"
            },
            "PERP_CLOSE": {
              "const": "PERP_TRADE"
            },
            "SPOT_ORDER": {
              "const": "SPOT_TRADE"
            },
            "INTERNAL_USD_SEND": {
              "const": "INTERNAL_TRANSFER"
            },
            "INTERNAL_SPOT_SEND": {
              "const": "INTERNAL_TRANSFER"
            },
            "ARBITRUM_WITHDRAW": {
              "const": "WITHDRAWAL"
            },
            "ARBITRUM_BRIDGE_DEPOSIT": {
              "const": "BRIDGE_DEPOSIT"
            },
            "HLP_DEPOSIT": {
              "const": "VAULT_MANAGE"
            },
            "HLP_WITHDRAW": {
              "const": "VAULT_MANAGE"
            },
            "USER_VAULT_DEPOSIT": {
              "const": "VAULT_MANAGE"
            },
            "USER_VAULT_WITHDRAW": {
              "const": "VAULT_MANAGE"
            },
            "HYPEREVM_VAULT_DEPOSIT": {
              "const": "VAULT_MANAGE"
            },
            "HYPEREVM_VAULT_WITHDRAW": {
              "const": "VAULT_MANAGE"
            },
            "USD_CLASS_TRANSFER": {
              "const": "INTERNAL_TRANSFER"
            },
            "SEND_ASSET": {
              "const": "ASSET_SEND"
            },
            "APPROVE_AGENT": {
              "const": "AGENT_ADMIN"
            },
            "REVOKE_AGENT": {
              "const": "AGENT_ADMIN"
            },
            "APPROVE_BUILDER_FEE": {
              "const": "BUILDER_FEE_ADMIN"
            },
            "CANCEL_ALL_ORDERS": {
              "const": "CANCEL_ORDERS"
            },
            "EMERGENCY_CLOSE": {
              "const": "EMERGENCY_CLOSE"
            }
          }
        },
        "requireQuoteValidUntil": {
          "const": true
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "accountBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxLifetimeSeconds",
        "signatureThreshold",
        "requiredRoles",
        "minimumDistinctOrganizations"
      ],
      "properties": {
        "maxLifetimeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        },
        "signatureThreshold": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8
        },
        "requiredRoles": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "minimumDistinctOrganizations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "networkRegistrySha256",
        "allowedSourceNetworkIds",
        "allowedDestinationNetworkIds"
      ],
      "properties": {
        "networkRegistrySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "allowedSourceNetworkIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._:-]+$"
          }
        },
        "allowedDestinationNetworkIds": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 128,
            "pattern": "^[a-z0-9][a-z0-9._:-]+$"
          }
        }
      }
    }
  }
}
