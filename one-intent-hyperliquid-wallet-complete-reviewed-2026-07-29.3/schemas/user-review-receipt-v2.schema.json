{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/user-review-receipt-v2.schema.json",
  "title": "UserReviewReceiptV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "canonicalProfile",
    "issuer",
    "subject",
    "audience",
    "environment",
    "deployment",
    "receiptId",
    "operationSpecDigest",
    "displayDigest",
    "quoteDigest",
    "sourceStateDigest",
    "finalPayloadDigest",
    "locale",
    "formattingVersion",
    "deviceId",
    "challengeNonce",
    "reviewedAt",
    "notBefore",
    "expiresAt",
    "canonicalDigest",
    "signatureAlgorithm",
    "keyId",
    "signature",
    "revocationEpoch"
  ],
  "properties": {
    "schemaVersion": {"const": "2.1"},
    "canonicalProfile": {"const": "CGPT-C14N-1"},
    "issuer": {"type": "string", "minLength": 1, "maxLength": 256},
    "subject": {"type": "string", "minLength": 1, "maxLength": 256},
    "audience": {"type": "string", "minLength": 1, "maxLength": 256},
    "environment": {"enum": ["STAGING", "TESTNET", "PRODUCTION"]},
    "deployment": {"type": "string", "minLength": 1, "maxLength": 256},
    "receiptId": {"type": "string", "minLength": 1, "maxLength": 128},
    "operationSpecDigest": {"$ref": "#/$defs/digest"},
    "displayDigest": {"$ref": "#/$defs/digest"},
    "quoteDigest": {"$ref": "#/$defs/digest"},
    "sourceStateDigest": {"$ref": "#/$defs/digest"},
    "finalPayloadDigest": {"$ref": "#/$defs/digest"},
    "locale": {"type": "string", "minLength": 2, "maxLength": 35, "pattern": "^[A-Za-z0-9-]+$"},
    "formattingVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "deviceId": {"type": "string", "minLength": 1, "maxLength": 256},
    "challengeNonce": {"type": "string", "minLength": 16, "maxLength": 256},
    "reviewedAt": {"type": "integer", "minimum": 0},
    "notBefore": {"type": "integer", "minimum": 0},
    "expiresAt": {"type": "integer", "minimum": 0},
    "canonicalDigest": {"$ref": "#/$defs/digest"},
    "signatureAlgorithm": {"const": "Ed25519"},
    "keyId": {"type": "string", "minLength": 1, "maxLength": 256},
    "signature": {"type": "string", "minLength": 1, "maxLength": 4096},
    "revocationEpoch": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
